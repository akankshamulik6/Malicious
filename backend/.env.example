APP_NAME=agri-ai-backend
APP_VERSION=1.0.0

# Database Connection (PostgreSQL for production, SQLite async for local dev/test)
# PostgreSQL example: postgresql+asyncpg://user:password@localhost:5432/agri_ai
DATABASE_URL=sqlite+aiosqlite:///./agri_ai.db

# Member 1 AI ML Service
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_SECONDS=30

# Member 2 Agricultural Intelligence Service
ADVISORY_SERVICE_URL=http://localhost:8002
ADVISORY_SERVICE_TIMEOUT_SECONDS=15

# Security & JWT Configuration
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend Allowed Origins (CORS)
FRONTEND_ORIGINS=http://localhost:5173

# Logging Configuration
LOG_LEVEL=INFO
